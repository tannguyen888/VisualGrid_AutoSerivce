# ==============================
# Data Pipeline Environment - TEMPLATE
# Copy this file to .env and fill in real values. .env is gitignored.
# ==============================

# Runtime
APP_ENV=development
LOG_LEVEL=INFO

# Scheduler (fixed daily sync time)
PIPELINE_CRON_HOUR=2
PIPELINE_CRON_MINUTE=0
PIPELINE_MAX_RETRIES=3
PIPELINE_RETRY_BACKOFF_SECONDS=10

# Set to false to actually write to the database instead of dry-run logging
PIPELINE_DRY_RUN=true

# CarAPI (https://carapi.app) - same account used by the Java backend
CARAPI_BASE_URL=https://carapi.app
CARAPI_API_TOKEN=
CARAPI_API_SECRET=
# Comma-separated make names to sync models for (kept small to respect rate limits)
CARAPI_SYNC_MAKES=Toyota,Honda,Ford

# Mock API call (used by legacy scheduler/job)
MOCK_API_URL=https://mock-api.example.com/pipeline
MOCK_API_KEY=replace-with-mock-token
MOCK_API_TIMEOUT=30

# PostgreSQL - point at the same "cardiag" DB the Java backend uses
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cardiag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# MongoDB (future use)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=autocare_pipeline

# Optional storage (future use)
STORAGE_PROVIDER=local
STORAGE_PATH=./data/artifacts
