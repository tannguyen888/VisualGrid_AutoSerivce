# ==============================
# Data Pipeline Environment
# ==============================

# Runtime
APP_ENV=development
LOG_LEVEL=INFO

# Scheduler
PIPELINE_CRON_HOUR=2
PIPELINE_CRON_MINUTE=0

# Mock API call (used by scheduler/job)
MOCK_API_URL=https://mock-api.example.com/pipeline
MOCK_API_KEY=replace-with-mock-token
MOCK_API_TIMEOUT=30

# PostgreSQL (future use)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autocare_pipeline
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MongoDB (future use)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=autocare_pipeline

# Optional storage (future use)
STORAGE_PROVIDER=local
STORAGE_PATH=./data/artifacts
